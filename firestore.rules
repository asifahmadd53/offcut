rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every shop can only touch its own data. The shop id is the login's user id.
    function isShopOwner(shopId) {
      return request.auth != null && request.auth.uid == shopId;
    }

    match /shops/{shopId} {

      // Cuts are an append-only history: they can be created and read, never edited or deleted.
      match /cuts/{cutId} {
        allow read: if isShopOwner(shopId);
        allow create: if isShopOwner(shopId);
        allow update, delete: if false;
      }

      // "Re-plan" / "I cut a different piece" answers for sync warnings.
      match /resolutions/{cutId} {
        allow read, create, update: if isShopOwner(shopId);
        allow delete: if false;
      }

      // Jobs the carpenter removed from their list. The cut itself is untouched —
      // this only hides it from view. Update is allowed (not just create) because
      // hiding the same job twice — e.g. a retry, or two phones hiding it around the
      // same time — must never fail: every write just restates "this job is hidden",
      // which is already true, so the operation is idempotent either way.
      match /hiddenJobs/{cutId} {
        allow read, create, update: if isShopOwner(shopId);
        allow delete: if false;
      }

      match /settings/{docId} {
        allow read, write: if isShopOwner(shopId);
      }
    }
  }
}
